diff --git a/runner/cyc/cyc_settings.c b/runner/cyc/cyc_settings.c
index b94b037..8400d19 100644
--- a/runner/cyc/cyc_settings.c
+++ b/runner/cyc/cyc_settings.c
@@ -6,6 +6,11 @@
 #include <ctype.h>
 #include <stdlib.h>
 #include <string.h>
+#ifdef __APPLE__
+#include <mach-o/dyld.h>
+#include <limits.h>
+#include <stdlib.h>
+#endif
 #ifdef _WIN32
 #include <windows.h>
 #else
@@ -36,6 +41,12 @@ const char *cyc_settings_default_path(void)
 #ifdef _WIN32
     DWORD n = GetModuleFileNameA(NULL, dir, sizeof(dir));
     if (n == 0 || n >= sizeof(dir)) strcpy(dir, ".");
+#elif defined(__APPLE__)
+    /* macOS has no /proc: without this the config lands in whatever folder
+     * the program was started from instead of beside it. */
+    uint32_t sz = sizeof(dir);
+    char raw[900];
+    if (_NSGetExecutablePath(raw, &sz) != 0 || !realpath(raw, dir)) strcpy(dir, ".");
 #else
     ssize_t n = readlink("/proc/self/exe", dir, sizeof(dir) - 1);
     if (n > 0) dir[n] = 0; else strcpy(dir, ".");
