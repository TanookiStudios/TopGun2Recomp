+/* A joystick SDL has no mapping for (a generic USB pad) still gets one:
+ * buttons in the common order, the first hat and the first two axes as the
+ * D-pad. Every button stays rebindable in the launcher. */
+static void map_unknown_joystick(int index)
+{
+    char guid[64], mapping[512];
+    SDL_JoystickGetGUIDString(SDL_JoystickGetDeviceGUID(index), guid, sizeof(guid));
+    const char *name = SDL_JoystickNameForIndex(index);
+    char clean[96];
+    snprintf(clean, sizeof(clean), "%s", name && *name ? name : "Generic controller");
+    for (char *c = clean; *c; ++c) if (*c == ',') *c = ' ';
+    snprintf(mapping, sizeof(mapping),
+             "%s,%s,a:b0,b:b1,x:b2,y:b3,leftshoulder:b4,rightshoulder:b5,back:b6,start:b7,"
+             "guide:b8,leftstick:b9,rightstick:b10,dpup:h0.1,dpright:h0.2,dpdown:h0.4,dpleft:h0.8,"
+             "leftx:a0,lefty:a1,", guid, clean);
+    if (SDL_GameControllerAddMapping(mapping) >= 0)
+        printf("[cyc input] no mapping for \"%s\": using the generic layout\n", clean);
+}
