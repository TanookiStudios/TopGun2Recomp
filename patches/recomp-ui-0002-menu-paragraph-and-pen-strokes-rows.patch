diff --git a/src/common/backends/imgui/runtime_ui_imgui.cpp b/src/common/backends/imgui/runtime_ui_imgui.cpp
index faf17f8..b85a5aa 100644
--- a/src/common/backends/imgui/runtime_ui_imgui.cpp
+++ b/src/common/backends/imgui/runtime_ui_imgui.cpp
@@ -112,6 +112,53 @@ void draw_items(RecompRuntimeUi *ui, const LauncherTheme &theme,
 
         const bool enabled = recomp_runtime_ui_item_enabled(ui, item) != 0;
         const bool selected = ui->in_section && index == ui->row_index;
+        if (item->type == RECOMP_RUNTIME_UI_PARAGRAPH ||
+            item->type == RECOMP_RUNTIME_UI_STROKES) {
+            /* Reading rows: wrapped text, or pen strokes (a signature). */
+            ImGui::PushID(static_cast<int>(index));
+            const ImVec2 start = ImGui::GetCursorScreenPos();
+            const float wrap = std::max(
+                40.0f, ImGui::GetContentRegionAvail().x - theme.spacing_md * 2.0f);
+            const char *text = item->description ? item->description : "";
+            const RecompRuntimeUiStrokes *strokes =
+                static_cast<const RecompRuntimeUiStrokes *>(item->data);
+            float scale = 1.0f, row_h;
+            if (item->type == RECOMP_RUNTIME_UI_PARAGRAPH) {
+                row_h = ImGui::CalcTextSize(text, nullptr, false, wrap).y +
+                        theme.spacing_sm * 2.0f;
+            } else {
+                if (strokes && strokes->width > 0.0f)
+                    scale = std::min(1.0f, std::min(wrap * 0.6f, 240.0f) / strokes->width);
+                row_h = (strokes ? strokes->height * scale : 0.0f) + theme.spacing_sm * 2.0f;
+            }
+            if (ImGui::Selectable("##reading", selected, 0, ImVec2(0.0f, row_h))) {
+                ui->row_index = index;
+                ui->in_section = 1;
+            }
+            if (ImGui::IsItemHovered()) {
+                ui->row_index = index;
+                ui->in_section = 1;
+            }
+            ImDrawList *draw = ImGui::GetWindowDrawList();
+            if (item->type == RECOMP_RUNTIME_UI_PARAGRAPH) {
+                draw->AddText(ImGui::GetFont(), ImGui::GetFontSize(),
+                              ImVec2(start.x + theme.spacing_md, start.y + theme.spacing_sm),
+                              u32(theme.text), text, nullptr, wrap);
+            } else if (strokes && strokes->data) {
+                const float *p = strokes->data;
+                ImVec2 pts[512];
+                while (*p >= 2.0f) {
+                    int n = static_cast<int>(*p++);
+                    if (n > 512) n = 512;
+                    for (int k = 0; k < n; ++k, p += 2)
+                        pts[k] = ImVec2(start.x + theme.spacing_md + p[0] * scale,
+                                        start.y + theme.spacing_sm + p[1] * scale);
+                    draw->AddPolyline(pts, n, u32(theme.text), ImDrawFlags_None, 1.8f);
+                }
+            }
+            ImGui::PopID();
+            continue;
+        }
         char value[128];
         value_text(ui, item, value, sizeof(value));
 
