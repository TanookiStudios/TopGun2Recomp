+/* The title's own options, before boot (GameInfo.game_items). ACTION rows
+ * are skipped: there is no running game for them to act on yet. */
+void draw_game_page(LauncherModel* m, const LauncherTheme& th) {
+    if (!begin_panel("game_page", 0, false)) {
+        end_panel();
+        return;
+    }
+    const RecompRuntimeUiCallbacks* cb = m->game_callbacks;
+    const char* section = nullptr;
+    for (size_t i = 0; cb && i < m->game_item_count; ++i) {
+        const RecompRuntimeUiItem* it = &m->game_items[i];
+        if (it->type == RECOMP_RUNTIME_UI_ACTION) continue;
+        const char* sec = it->section ? it->section : "";
+        if (!section || strcmp(section, sec) != 0) {
+            if (section) ImGui::Dummy(ImVec2(0, px(10.0f)));
+            section = sec;
+            eyebrow(sec);
+        }
+        ImGui::PushID((int)i);
+        int v = 0;
+        if (cb->get_value) cb->get_value(cb->context, it, &v);
+        ImGui::PushStyleColor(ImGuiCol_Text, col(th.text));
+        if (it->type == RECOMP_RUNTIME_UI_BOOL) {
+            bool b = v != 0;
+            if (ImGui::Checkbox(it->label, &b) && cb->set_value) cb->set_value(cb->context, it, b ? 1 : 0);
+        } else if (it->type == RECOMP_RUNTIME_UI_CHOICE && it->choices && it->choice_count) {
+            int cur = -1;
+            for (size_t c = 0; c < it->choice_count; ++c) {
+                int cv = it->choice_values ? it->choice_values[c] : it->minimum + (int)c;
+                if (cv == v) cur = (int)c;
+            }
+            ImGui::SetNextItemWidth(px(220.0f));
+            if (ImGui::BeginCombo(it->label, cur >= 0 ? it->choices[cur] : "")) {
+                for (size_t c = 0; c < it->choice_count; ++c) {
+                    int cv = it->choice_values ? it->choice_values[c] : it->minimum + (int)c;
+                    if (ImGui::Selectable(it->choices[c], (int)c == cur) && cb->set_value)
+                        cb->set_value(cb->context, it, cv);
+                }
+                ImGui::EndCombo();
+            }
+        } else {
+            ImGui::TextUnformatted(it->label ? it->label : "");
+        }
+        ImGui::PopStyleColor();
+        if (it->description && it->description[0]) {
+            ImGui::PushStyleColor(ImGuiCol_Text, col(th.text_muted));
+            ImGui::PushTextWrapPos();
+            ImGui::TextWrapped("%s", it->description);
+            ImGui::PopTextWrapPos();
+            ImGui::PopStyleColor();
+        }
+        ImGui::Dummy(ImVec2(0, px(4.0f)));
+        ImGui::PopID();
+    }
+    end_panel();
+}
+
+/* GameInfo.about_text, then about_image (a signature) and the link button. */
+void draw_about(LauncherModel* m, const LauncherTheme& th) {
+    if (!begin_panel("about_page", 0, false)) {
+        end_panel();
+        return;
+    }
+    eyebrow("ABOUT");
+    ImGui::PushStyleColor(ImGuiCol_Text, col(th.text));
+    ImGui::PushTextWrapPos();
+    const char* t = m->about_text ? m->about_text : "";
+    while (*t) {   /* blank lines split paragraphs */
+        const char* end = strstr(t, "\n\n");
+        std::string para(t, end ? (size_t)(end - t) : strlen(t));
+        ImGui::TextWrapped("%s", para.c_str());
+        ImGui::Dummy(ImVec2(0, px(6.0f)));
+        if (!end) break;
+        t = end + 2;
+    }
+    ImGui::PopTextWrapPos();
+    ImGui::PopStyleColor();
+    if (g_about_image.id) image_fit(g_about_image, px(240.0f), px(84.0f));
+    if (m->about_link_url && m->about_link_url[0]) {
+        ImGui::Dummy(ImVec2(0, px(6.0f)));
+        const char* label = m->about_link_label && m->about_link_label[0] ? m->about_link_label : "Open link";
+        if (ImGui::Button(label, ImVec2(px(220.0f), px(38.0f)))) {
+#if defined(LNG_SDL3)
+            SDL_OpenURL(m->about_link_url);
+#else
+            (void)SDL_OpenURL(m->about_link_url);
+#endif
+        }
+    }
+    end_panel();
+}
