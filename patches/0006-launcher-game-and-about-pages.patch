diff --git a/runner/cyc/cyc_host_extras.h b/runner/cyc/cyc_host_extras.h
index 6c9c768..5a6abd6 100644
--- a/runner/cyc/cyc_host_extras.h
+++ b/runner/cyc/cyc_host_extras.h
@@ -105,6 +105,14 @@ typedef struct CycHostExtras {
     unsigned audio_rate;
     void (*audio_mix)(void *ctx, int16_t *samples, size_t count);
     void (*state_loaded)(void *ctx);
+    /* The launcher's About page (recomp-ui GameInfo.about_*): body text,
+     * an image under assets/img drawn after it, and a link button. NULL text
+     * => no page. The launcher's Game page shows menu_items (ACTION rows
+     * excepted) through menu_callbacks. */
+    const char *about_text;
+    const char *about_image;
+    const char *about_link_url;
+    const char *about_link_label;
 } CycHostExtras;
 
 const CycHostExtras *cyc_host_extras(void);
diff --git a/runner/cyc/cyc_ui_launcher.c b/runner/cyc/cyc_ui_launcher.c
index 66e3bdd..92659fc 100644
--- a/runner/cyc/cyc_ui_launcher.c
+++ b/runner/cyc/cyc_ui_launcher.c
@@ -216,7 +216,19 @@ int cyc_ui_launcher(CycSettings *settings, const char *settings_path, const CycH
     gi.has_integer_scale = 1;
     /* a game's view modes are a runtime-menu row (live), not a launcher toggle */
     gi.widescreen_supported = 0;
+#ifdef RECOMP_LAUNCHER_HAS_GAME_AND_ABOUT_PAGES
+    if (extras) {
+        gi.game_items = extras->menu_items;
+        gi.game_item_count = extras->menu_item_count;
+        gi.game_callbacks = extras->menu_callbacks;
+        gi.about_text = extras->about_text;
+        gi.about_image = extras->about_image;
+        gi.about_link_url = extras->about_link_url;
+        gi.about_link_label = extras->about_link_label;
+    }
+#else
     (void)extras;
+#endif
     gi.config_path = settings_path;
 #ifdef CYC_GAME_PASSWORD_SAVE
     /* --config must not redirect an existing mantra away from the executable. */
